# O aplicativo lê variáveis exportadas; este arquivo não é carregado automaticamente.
SUPPORTOPS_MODE=demo
SUPPORTOPS_RETRIEVAL=lexical
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
# Para seleção restrita: SUPPORTOPS_MODE=grounded e SUPPORTOPS_RETRIEVAL=semantic.
# O modo grounded exige o digest calibrado em data/grounding-v3.json.

# Banco local exclusivo da simulação; padrão: projects/supportops-ai/var/actions.sqlite3
# SUPPORTOPS_ACTION_DB=/caminho/absoluto/actions.sqlite3

# Local permite token vazio; production exige pelo menos 32 caracteres.
SUPPORTOPS_ENV=local
SUPPORTOPS_API_KEY=
# Receptor HTTP externo de teste (processo separado).
SUPPORTOPS_SINK_KEY=
# SUPPORTOPS_SINK_DB=/caminho/absoluto/sink.sqlite3
